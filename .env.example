# Names only — never commit real values. Copy to .env.local per worktree.

# --- Database (PostGIS) ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- API ---
API_PORT=
API_CORS_ORIGINS=
API_LOG_LEVEL=
API_ADMIN_TOKEN_HASH=
API_RATE_LIMIT_PER_MINUTE=
# API_ADMIN_TOKEN_HASH = SHA-256 hex of the admin token (optional 'sha256:' prefix)
# v1.3 (CR-ROUTING-1): fixture|postgis|none
ROUTING_GRAPH_SOURCE=
ROUTING_FIXTURE_DIR=
# memory|postgis
API_STORE_BACKEND=
# none | module:factory
RISK_PROVIDER=
ROUTING_WORKERS=
# Weather adapter: none|postgis; observations older than this are reported unavailable (503)
WEATHER_SOURCE=
WEATHER_MAX_AGE_MINUTES=
WEATHER_STATION_IDS=

# --- Test harness (CR-PLAT-2; local/CI only) ---
API_BASE_URL=
API_LOG_FILE=
# plaintext admin token for local tests only; production stores only API_ADMIN_TOKEN_HASH
API_ADMIN_TOKEN=
API_APP=
STUB_PORT=
STUB_ADMIN_TOKEN=
CORS_ALLOWED_ORIGIN=

# --- Data sources ---
# Montreal Planif-Neige token (opt-in; request from donneesouvertes@montreal.ca)
MTL_PLANIF_NEIGE_TOKEN=
DATA_DIR=
HTTP_USER_AGENT=

# --- Geocoding (backend-only; provider must permit autocomplete) ---
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# --- ML ---
MODEL_ARTIFACT_DIR=
MODEL_REGISTRY_PATH=

# --- Web (Vite exposes VITE_* to the browser — no secrets here) ---
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=
WEB_PORT=

# --- v1.7 deployment (free tier) ---
# API: false => POST /reports and /pilot-requests return 503 WRITES_DISABLED (read-only demo)
API_PUBLIC_WRITES=
# API: risk score source for the heuristic/model layer: file (models/artifacts, local dev) | postgis (wp.risk_cell_score)
RISK_SCORE_SOURCE=
# API: SQLAlchemy pool for Supabase session pooler (small on Render Free)
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
# Render injects PORT (default 10000); the API image binds 0.0.0.0:$PORT
PORT=
# Web (public, baked into the bundle): false hides report/pilot forms
VITE_PUBLIC_WRITES=
# Web: per-request timeout and cold-start messaging (ms)
VITE_API_TIMEOUT_MS=
