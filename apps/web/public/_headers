# Cloudflare Pages headers. Upper-case placeholders in double braces are filled at build time by build/cloudflarePages.ts
# (API origin from VITE_API_BASE_URL, map origins, hashes of index.html inline scripts).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{MAP_ORIGINS}}; font-src 'self'; connect-src 'self' {{API_ORIGIN}} {{MAP_ORIGINS}}; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=31536000, immutable
